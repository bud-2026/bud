# Screen analysis and classification always run on the bundled Qwen3-VL server,
# which the app downloads and starts on a free local port at launch.
#
# General knowledge questions are answered by the Nebius API. Set
# GENERAL_USE_LOCAL=true to answer them on the bundled local model instead.
GENERAL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
GENERAL_API_KEY=your_general_api_key
GENERAL_MODEL_ID=your_general_model_id
GENERAL_USE_LOCAL=false

# A separate inference pass rewrites each answer into TTS-friendly spoken text
# (numbers, dates, units, and symbols expanded). Set PHONETIC_USE_LOCAL=true to
# run it on the bundled local model; when using an external endpoint and the
# fields below are left blank, answers fall back to the built-in regex cleanup.
PHONETIC_BASE_URL=
PHONETIC_API_KEY=
PHONETIC_MODEL_ID=
PHONETIC_USE_LOCAL=false
