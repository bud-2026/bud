# Screen analysis and classification always run on the bundled Qwen3-VL server,
# which the app downloads and starts on a free local port at launch.
#
# General knowledge questions are answered by the Nebius API.
GENERAL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
GENERAL_API_KEY=your_general_api_key
GENERAL_MODEL_ID=your_general_model_id

# A separate inference pass rewrites each answer into TTS-friendly spoken text
# (numbers, dates, units, and symbols expanded). When left blank, answers fall
# back to the built-in regex text cleanup.
PHONETIC_BASE_URL=
PHONETIC_API_KEY=
PHONETIC_MODEL_ID=
